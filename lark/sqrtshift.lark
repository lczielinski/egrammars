start: "(FPCore (x) " body ")"
body: e0 | "(if " cond " " body " " body ")"
cond: "(< " operand " " operand ")" | "(> " operand " " operand ")" | "(<= " operand " " operand ")" | "(>= " operand " " operand ")"
operand: "x" | NUMBER
NUMBER: /-?[0-9]+(\.[0-9]+)?/
e0: "(* " e2 " " e5 ")" | "(* " e4 " " e5 ")" | "(* " e5 " " e2 ")" | "(* " e5 " " e4 ")" | "(- " e6 ")" | "(/ " e1 " " e0 ")" | "(/ " e2 " " e3 ")" | "(/ " e4 " " e3 ")"
e1: "x"
e2: "(+ " e7 " " e8 ")" | "(+ " e8 " " e7 ")" | "(- " e7 " " e1 ")"
e3: "(- " e0 ")"
e4: "(- " e1 ")"
e5: "(/ " e9 " " e3 ")"
e6: "(* " e1 " " e5 ")" | "(/ " e1 " " e3 ")"
e7: "(sqrt " e10 ")" | "-2" | "-4" | "2" | "4"
e8: "(- " e1 ")"
e9: "1"
e10: "0"
