start: "(FPCore (x) " body ")"
body: e0 | "(if " cond " " body " " body ")"
cond: "(< " operand " " operand ")" | "(> " operand " " operand ")" | "(<= " operand " " operand ")" | "(>= " operand " " operand ")"
operand: "x" | NUMBER
NUMBER: /-?[0-9]+(\.[0-9]+)?/
e0: "(* " e11 " " e9 ")" | "(* " e9 " " e11 ")" | "(+ " e1 " " e2 ")" | "(+ " e1 " " e3 ")" | "(+ " e1 " " e4 ")" | "(+ " e2 " " e1 ")" | "(+ " e3 " " e1 ")" | "(+ " e4 " " e1 ")" | "(+ " e5 " " e6 ")" | "(+ " e6 " " e5 ")" | "(- " e1 " " e13 ")" | "(- " e12 ")" | "(- " e5 " " e14 ")" | "(/ " e7 " " e8 ")" | "(/ " e9 " " e10 ")"
e1: "(* " e11 " " e15 ")" | "(* " e14 " " e16 ")" | "(* " e15 " " e11 ")" | "(* " e6 " " e17 ")" | "(/ " e15 " " e10 ")"
e2: "(- " e13 ")"
e3: "(* " e18 " " e11 ")" | "(/ " e18 " " e10 ")" | "(/ " e19 " " e8 ")"
e4: "(* " e11 " " e18 ")"
e5: "(sqrt " e19 ")"
e6: "(- " e14 ")" | "-2"
e7: "x"
e8: "(+ " e14 " " e5 ")" | "(+ " e5 " " e14 ")" | "(/ " e9 " " e20 ")"
e9: "(+ " e15 " " e18 ")" | "(+ " e18 " " e15 ")" | "(- " e15 " " e19 ")" | "(- " e7 ")"
e10: "(+ " e21 " " e6 ")" | "(+ " e6 " " e21 ")" | "(- " e6 " " e5 ")" | "(- " e8 ")"
e11: "(/ " e22 " " e10 ")"
e12: "(* " e7 " " e11 ")" | "(/ " e7 " " e10 ")"
e13: "(* " e11 " " e19 ")" | "(* " e19 " " e11 ")" | "(+ " e1 " " e12 ")" | "(+ " e12 " " e1 ")" | "(/ " e19 " " e10 ")"
e14: "2"
e15: "(* " e14 " " e14 ")" | "(* " e6 " " e6 ")" | "(- " e23 ")" | "4"
e16: "(* " e14 " " e11 ")"
e17: "(* " e6 " " e11 ")"
e18: "(- " e19 ")"
e19: "(+ " e15 " " e7 ")" | "(+ " e7 " " e15 ")"
e20: "(- " e14 " " e5 ")"
e21: "(- " e5 ")"
e22: "1"
e23: "(* " e14 " " e6 ")" | "(* " e6 " " e14 ")" | "-4"
