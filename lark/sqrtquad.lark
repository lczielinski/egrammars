start: "(FPCore (x) " body ")"
body: e0 | "(if " cond " " body " " body ")"
cond: "(< " operand " " operand ")" | "(> " operand " " operand ")" | "(<= " operand " " operand ")" | "(>= " operand " " operand ")"
operand: "x" | NUMBER
NUMBER: /-?[0-9]+(\.[0-9]+)?/
e0: "(* " e10 " " e6 ")" | "(* " e6 " " e10 ")" | "(+ " e1 " " e2 ")" | "(+ " e3 " " e4 ")" | "(+ " e5 " " e6 ")" | "(+ " e6 " " e5 ")" | "(- " e11 ")" | "(- " e5 " " e7 ")" | "(/ " e6 " " e9 ")" | "(/ " e7 " " e8 ")"
e1: "(* " e7 " " e7 ")"
e2: "(+ " e3 " " e5 ")"
e3: "(- " e12 ")"
e4: "(+ " e1 " " e5 ")"
e5: "(sqrt " e12 ")"
e6: "(- " e7 ")"
e7: "x"
e8: "(+ " e5 " " e7 ")" | "(+ " e7 " " e5 ")" | "(/ " e6 " " e13 ")"
e9: "(+ " e1 " " e14 ")" | "(+ " e16 " " e6 ")" | "(+ " e3 " " e15 ")" | "(+ " e6 " " e16 ")" | "(- " e6 " " e5 ")" | "(- " e8 ")"
e10: "(/ " e17 " " e9 ")"
e11: "(* " e7 " " e10 ")" | "(/ " e7 " " e9 ")"
e12: "(+ " e1 " " e7 ")" | "(+ " e7 " " e1 ")"
e13: "(- " e7 " " e5 ")"
e14: "(+ " e3 " " e16 ")"
e15: "(+ " e1 " " e16 ")"
e16: "(- " e5 ")"
e17: "1"
