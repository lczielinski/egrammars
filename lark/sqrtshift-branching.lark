start: "(FPCore (x) " body ")"
body: e0 | "(if " cond " " body " " body ")"
cond: "(< " operand " " operand ")" | "(> " operand " " operand ")" | "(<= " operand " " operand ")" | "(>= " operand " " operand ")"
operand: "x" | NUMBER
NUMBER: /-?[0-9]+(\.[0-9]+)?/
e0: "(+ " e1 " " e2 ")" | "(+ " e2 " " e1 ")" | "(- " e1 " " e6 ")" | "(/ " e3 " " e4 ")" | "(/ " e5 " " e4 ")"
e1: "(* " e7 " " e8 ")" | "(* " e8 " " e7 ")" | "(sqrt " e10 ")" | "(sqrt " e9 ")"
e2: "(- " e6 ")" | "-2"
e3: "(- " e11 " " e9 ")"
e4: "(- " e2 " " e1 ")"
e5: "(- " e11 " " e10 ")"
e6: "2"
e7: "(* " e12 " " e13 ")" | "(sqrt " e14 ")"
e8: "(sqrt " e15 ")"
e9: "(* " e14 " " e15 ")" | "(* " e15 " " e14 ")" | "(+ " e15 " " e16 ")" | "(+ " e16 " " e15 ")"
e10: "(+ " e15 " " e17 ")" | "(+ " e17 " " e15 ")"
e11: "(* " e2 " " e2 ")"
e12: "(sqrt " e18 ")"
e13: "(sqrt " e19 ")"
e14: "(+ " e18 " " e20 ")" | "(+ " e20 " " e18 ")"
e15: "x"
e16: "(* " e15 " " e18 ")"
e17: "4"
e18: "(* " e17 " " e21 ")" | "(* " e21 " " e17 ")" | "(/ " e17 " " e15 ")"
e19: "(+ " e20 " " e22 ")"
e20: "1"
e21: "(/ " e20 " " e15 ")"
e22: "(/ " e20 " " e18 ")"
