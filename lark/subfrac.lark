start: "(FPCore (x) " body ")"
body: e0 | "(if " cond " " body " " body ")"
cond: "(< " operand " " operand ")" | "(> " operand " " operand ")" | "(<= " operand " " operand ")" | "(>= " operand " " operand ")"
operand: "x" | NUMBER
NUMBER: /-?[0-9]+(\.[0-9]+)?/
e0: "(* " e11 " " e9 ")" | "(* " e12 " " e5 ")" | "(* " e2 " " e7 ")" | "(* " e5 " " e12 ")" | "(* " e7 " " e2 ")" | "(* " e9 " " e11 ")" | "(+ " e1 " " e2 ")" | "(+ " e2 " " e1 ")" | "(+ " e2 " " e3 ")" | "(+ " e2 " " e4 ")" | "(+ " e3 " " e2 ")" | "(+ " e4 " " e2 ")" | "(- " e11 ")" | "(- " e2 " " e12 ")" | "(- " e2 " " e13 ")" | "(/ " e5 " " e6 ")" | "(/ " e7 " " e8 ")" | "(/ " e9 " " e10 ")"
e1: "(- " e13 ")"
e2: "(* " e12 " " e15 ")" | "(* " e15 " " e12 ")" | "(/ " e14 " " e8 ")" | "(/ " e6 " " e10 ")"
e3: "(* " e11 " " e16 ")" | "(* " e12 " " e18 ")" | "(* " e16 " " e11 ")" | "(* " e17 " " e2 ")" | "(* " e18 " " e12 ")" | "(* " e2 " " e17 ")" | "(/ " e16 " " e10 ")"
e4: "(- " e12 ")"
e5: "(* " e2 " " e9 ")" | "(* " e9 " " e2 ")" | "(+ " e18 " " e19 ")" | "(+ " e19 " " e18 ")" | "(+ " e19 " " e20 ")" | "(- " e19 " " e21 ")" | "(/ " e9 " " e8 ")"
e6: "x"
e7: "(* " e12 " " e9 ")" | "(* " e9 " " e12 ")" | "(+ " e17 " " e22 ")" | "(+ " e22 " " e17 ")" | "(+ " e22 " " e23 ")" | "(- " e22 " " e24 ")" | "(/ " e9 " " e6 ")"
e8: "(+ " e14 " " e6 ")" | "(+ " e6 " " e14 ")"
e9: "(+ " e16 " " e6 ")" | "(+ " e6 " " e16 ")" | "(- " e14 ")" | "(- " e6 " " e8 ")" | "-1"
e10: "(* " e6 " " e8 ")" | "(* " e8 " " e6 ")" | "(+ " e25 " " e6 ")" | "(+ " e6 " " e25 ")"
e11: "(/ " e12 " " e8 ")" | "(/ " e14 " " e10 ")"
e12: "(/ " e14 " " e6 ")"
e13: "(* " e11 " " e8 ")" | "(* " e12 " " e21 ")" | "(* " e2 " " e24 ")" | "(* " e21 " " e12 ")" | "(* " e24 " " e2 ")" | "(* " e8 " " e11 ")" | "(+ " e11 " " e2 ")" | "(+ " e2 " " e11 ")" | "(/ " e8 " " e10 ")"
e14: "1"
e15: "(/ " e6 " " e8 ")"
e16: "(- " e8 ")"
e17: "(* " e12 " " e16 ")" | "(* " e16 " " e12 ")"
e18: "(* " e16 " " e2 ")" | "(* " e2 " " e16 ")"
e19: "(* " e2 " " e6 ")" | "(* " e6 " " e2 ")"
e20: "(- " e21 ")"
e21: "(* " e2 " " e8 ")" | "(* " e8 " " e2 ")" | "(+ " e19 " " e2 ")" | "(+ " e2 " " e19 ")"
e22: "(* " e12 " " e6 ")" | "(* " e6 " " e12 ")"
e23: "(- " e24 ")"
e24: "(* " e12 " " e8 ")" | "(* " e8 " " e12 ")" | "(+ " e12 " " e22 ")" | "(+ " e22 " " e12 ")"
e25: "(* " e6 " " e6 ")"
