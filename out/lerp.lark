start: "(FPCore (end scale start) " e0 ")" "\n"?
e0: "(+ " e1 " " e2 ")" | "(+ " e2 " " e1 ")" | "(+ " e3 " " e4 ")" | "(+ " e4 " " e3 ")" | "(+ " e4 " " e8 ")" | "(+ " e5 " " e6 ")" | "(+ " e6 " " e5 ")" | "(+ " e6 " " e7 ")" | "(+ " e7 " " e6 ")" | "(+ " e8 " " e4 ")"
e1: "start"
e2: "(* " e10 " " e9 ")" | "(* " e9 " " e10 ")" | "(+ " e4 " " e5 ")" | "(+ " e4 " " e7 ")" | "(+ " e5 " " e4 ")" | "(+ " e7 " " e4 ")" | "(- " e4 " " e11 ")"
e3: "(+ " e1 " " e7 ")" | "(+ " e5 " " e1 ")" | "(+ " e7 " " e1 ")"
e4: "(* " e12 " " e9 ")" | "(* " e9 " " e12 ")"
e5: "(- " e11 ")"
e6: "(+ " e1 " " e4 ")" | "(+ " e4 " " e1 ")"
e7: "(* " e13 " " e9 ")" | "(* " e9 " " e13 ")"
e8: "(+ " e1 " " e5 ")" | "(+ " e5 " " e1 ")"
e9: "scale"
e10: "(+ " e12 " " e13 ")" | "(+ " e13 " " e12 ")" | "(- " e12 " " e1 ")"
e11: "(* " e1 " " e9 ")" | "(* " e9 " " e1 ")"
e12: "end"
e13: "(- " e1 ")"
