(datatype Math
  (Num i64)
  (Var String)
  (Add Math Math)
  (Sub Math Math)
  (Neg Math)
  (Sqrt Math)
  (Mul Math Math)
  (Div Math Math))

(rewrite (Add a b)
  (Add b a))
(rewrite (Add (Num a) (Num b))
  (Num (+ a b)))
(rewrite (Add (Add a b) c)
  (Add a (Add b c)))
(rewrite (Neg a)
  (Sub (Num 0) a))
(rewrite (Sub (Num 0) a)
  (Neg a))
(rewrite (Sub a b)
  (Add a (Neg b)))
(rewrite (Sub (Num a) (Num b))
  (Num (- a b)))
(rewrite (Mul a b)
  (Mul b a))
(rewrite (Mul (Num a) (Num b))
  (Num (* a b)))
(rewrite (Mul (Mul a b) c)
  (Mul a (Mul b c)))
(rewrite (Mul a (Add b c))
  (Add (Mul a b) (Mul a c)))

(rewrite (Div a b)
  (Mul a (Div (Num 1) b)))
(rewrite (Mul a (Div (Num 1) b))
  (Div a b))
(birewrite (Div (Num 1) (Mul b c))
  (Mul (Div (Num 1) b) (Div (Num 1) c)))
(rewrite (Div (Sub a b) c)
  (Sub (Div a c) (Div b c)))
(rewrite (Div (Add a b) c)
  (Add (Div a c) (Div b c)))
(rewrite (Mul a (Sub b c))
  (Sub (Mul a b) (Mul a c)))
(rewrite (Div (Mul a b) (Mul c d))
  (Mul (Div a c) (Div b d)))
(rewrite (Mul (Sub a b) (Sub a b))
  (Mul (Sub b a) (Sub b a)))

;; Conjugate rationalization p + sqrt(d) = (p*p - d) / (p - sqrt(d))
(rewrite (Add p (Sqrt d))
  (Div (Sub (Mul p p) d) (Sub p (Sqrt d))))

;; 1/a - 1/b = (b-a)/(ab); the general p/a - q/b form cross-multiplies everywhere
(rewrite (Sub (Div (Num 1) a) (Div (Num 1) b))
  (Div (Sub b a) (Mul a b)))
;; a - (a+b) = -b
(rewrite (Sub a (Add a b))
  (Neg b))
;; -a + -b = -(a+b)
(rewrite (Add (Neg a) (Neg b))
  (Neg (Add a b)))
;; (-a)/(-b) = a/b
(rewrite (Div (Neg a) (Neg b))
  (Div a b))

;; Identity eliminations: canonicalize during saturation so other rules match
;; the bare term; strip_identity_enodes (egrammar.py) drops the padded spellings.
(rewrite (Mul (Num 1) x)
  x)
(rewrite (Div x (Num 1))
  x)
(rewrite (Add (Num 0) x)
  x)
(rewrite (Neg (Neg a))
  a)

(rewrite (Mul (Neg a) (Neg a))
  (Mul a a))
(rewrite (Sub a (Sub a b))
  b)
(rewrite (Div (Mul a x) (Mul a y))
  (Div x y))
(rewrite (Div (Mul a x) a)
  x)

;; --- General identities (high fan-out: combined with the forward rules above
;; they grow the e-graph fast, so keep --saturation low for big expressions) ---

;; Factoring: the reverse of the (Mul a (Add/Sub ...)) distribution rules. Always
;; valid; lets the e-graph reach factored forms (e.g. Heron's binomial product).
(rewrite (Add (Mul a b) (Mul a c))
  (Mul a (Add b c)))
(rewrite (Sub (Mul a b) (Mul a c))
  (Mul a (Sub b c)))

;; sqrt distributes over product and quotient (nonnegative operands, as in the
;; benchmark domains): moves factors in and out of a square root.
(birewrite (Sqrt (Mul a b))
  (Mul (Sqrt a) (Sqrt b)))
(birewrite (Sqrt (Div a b))
  (Div (Sqrt a) (Sqrt b)))
;; sqrt(a) * sqrt(a) = a
(rewrite (Mul (Sqrt a) (Sqrt a))
  a)
