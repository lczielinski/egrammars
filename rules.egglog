(datatype Math
  (Num i64)
  (Var String)
  (Add Math Math)
  (Sub Math Math)
  (Neg Math)
  (Sqrt Math)
  (Mul Math Math)
  (Div Math Math))

(rewrite (Add a b) (Add b a))
(rewrite (Add (Num a) (Num b)) (Num (+ a b)))
(rewrite (Add (Add a b) c) (Add a (Add b c)))
(birewrite (Neg a) (Sub (Num 0) a))
(rewrite (Sub a b) (Add a (Neg b)))
(rewrite (Sub (Num a) (Num b)) (Num (- a b)))
(rewrite (Mul a b) (Mul b a))
(rewrite (Mul (Num a) (Num b)) (Num (* a b)))
(rewrite (Mul (Mul a b) c) (Mul a (Mul b c)))
(birewrite (Mul a (Add b c)) (Add (Mul a b) (Mul a c)))

(birewrite (Div a b) (Mul a (Div (Num 1) b)))
(birewrite (Div (Num 1) (Mul b c)) (Mul (Div (Num 1) b) (Div (Num 1) c)))
(rewrite (Div (Sub a b) c) (Sub (Div a c) (Div b c)))
(rewrite (Div (Add a b) c) (Add (Div a c) (Div b c)))
(birewrite (Mul a (Sub b c)) (Sub (Mul a b) (Mul a c)))
(rewrite (Div (Mul a b) (Mul c d)) (Mul (Div a c) (Div b d)))
(rewrite (Mul (Sub a b) (Sub a b)) (Mul (Sub b a) (Sub b a)))

(rewrite (Add p (Sqrt d)) (Div (Sub (Mul p p) d) (Sub p (Sqrt d))))

(rewrite (Sub (Div (Num 1) a) (Div (Num 1) b)) (Div (Sub b a) (Mul a b)))
(rewrite (Sub a (Add a b)) (Neg b))
(rewrite (Add (Neg a) (Neg b)) (Neg (Add a b)))
(rewrite (Div (Neg a) (Neg b)) (Div a b))

(rewrite (Mul (Num 1) x) x)
(rewrite (Div x (Num 1)) x)
(rewrite (Add (Num 0) x) x)
(rewrite (Neg (Neg a)) a)

(rewrite (Mul (Neg a) (Neg a)) (Mul a a))
(rewrite (Sub a (Sub a b)) b)

;; ------------------------------------------------------------------------------
;; Interval abstract interpretation, and the domain-conditional rewrites it guards.
;; ------------------------------------------------------------------------------

(function lo (Math) f64 :merge (max old new))
(function hi (Math) f64 :merge (min old new))

(rule ((= e (Num n))) 
    ((set (lo e) (to-f64 n)) (set (hi e) (to-f64 n))))
(rule ((= e (Neg a)) (= la (lo a)) (= ha (hi a))) ((set (lo e) (neg ha)) 
    (set (hi e) (neg la))))
(rule ((= e (Add a b)) (= la (lo a)) (= lb (lo b)) (= ha (hi a)) (= hb (hi b))) 
    ((set (lo e) (+ la lb)) (set (hi e) (+ ha hb))))
(rule ((= e (Sub a b)) (= la (lo a)) (= lb (lo b)) (= ha (hi a)) (= hb (hi b))) 
    ((set (lo e) (- la hb)) (set (hi e) (- ha lb))))
(rule ((= e (Mul a b)) (= la (lo a)) (= lb (lo b)) (= ha (hi a)) (= hb (hi b))) 
    ((set (lo e) (min (min (* la lb) (* la hb)) (min (* ha lb) (* ha hb)))) 
    (set (hi e) (max (max (* la lb) (* la hb)) (max (* ha lb) (* ha hb))))))
(rule ((= e (Div a b)) (= la (lo a)) (= lb (lo b)) (= ha (hi a)) (= hb (hi b)) (> lb 0.0)) 
    ((set (lo e) (min (min (/ la lb) (/ la hb)) (min (/ ha lb) (/ ha hb)))) 
    (set (hi e) (max (max (/ la lb) (/ la hb)) (max (/ ha lb) (/ ha hb))))))
(rule ((= e (Div a b)) (= la (lo a)) (= lb (lo b)) (= ha (hi a)) (= hb (hi b)) (< hb 0.0)) 
    ((set (lo e) (min (min (/ la lb) (/ la hb)) (min (/ ha lb) (/ ha hb)))) 
    (set (hi e) (max (max (/ la lb) (/ la hb)) (max (/ ha lb) (/ ha hb))))))
;; sqrt: loose sound upper bound sqrt(t) <= t+1 for t >= 0.
(rule ((= e (Sqrt a)) (>= (lo a) 0.0) (= ha (hi a)))
    ((set (lo e) 0.0) (set (hi e) (+ ha 1.0))))

;; sqrt-factoring: sound only where every sqrt operand is proven >= 0
(rule ((= e (Sqrt (Mul a b))) (>= (lo a) 0.0) (>= (lo b) 0.0)) ((union e (Mul (Sqrt a) (Sqrt b)))))
(rule ((= e (Sqrt (Div a b))) (>= (lo a) 0.0) (> (lo b) 0.0)) ((union e (Div (Sqrt a) (Sqrt b)))))
(rule ((= e (Sqrt (Add a (Num n)))) (> (lo a) 0.0) (>= n 0)) ((union e (Mul (Sqrt a) (Sqrt (Add (Num 1) (Div (Num n) a)))))))
(rule ((= e (Mul (Sqrt a) (Sqrt a))) (>= (lo a) 0.0)) ((union e a)))

;; division cancellation: sound only where the cancelled factor a is proven != 0
(rule ((= e (Div (Mul a x) (Mul a y))) (> (lo a) 0.0)) ((union e (Div x y))))
(rule ((= e (Div (Mul a x) (Mul a y))) (< (hi a) 0.0)) ((union e (Div x y))))
(rule ((= e (Div (Mul a x) a)) (> (lo a) 0.0)) ((union e x)))
(rule ((= e (Div (Mul a x) a)) (< (hi a) 0.0)) ((union e x)))
