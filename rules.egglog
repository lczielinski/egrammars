(datatype Math
  (Num i64)
  (Var String)
  (Add Math Math)
  (Sub Math Math)
  (Neg Math)
  (Sqrt Math)
  (Mul Math Math)
  (Div Math Math))

;; `expand` = the combinatorial engine (associativity, commutativity, distribution,
;; factoring); the default ruleset = folding / identities / cancellation / interval
;; analysis. egrammar.py throttles `expand` to keep the e-graph from blowing up.
(ruleset expand)

;; associativity / commutativity
(rewrite (Add a b) (Add b a) :ruleset expand)
(rewrite (Add (Add a b) c) (Add a (Add b c)) :ruleset expand)
(rewrite (Mul a b) (Mul b a) :ruleset expand)
(rewrite (Mul (Mul a b) c) (Mul a (Mul b c)) :ruleset expand)

;; distribution / division / fraction combination
(birewrite (Mul a (Add b c)) (Add (Mul a b) (Mul a c)) :ruleset expand)
(birewrite (Mul a (Sub b c)) (Sub (Mul a b) (Mul a c)) :ruleset expand)
(birewrite (Div a b) (Mul a (Div (Num 1) b)) :ruleset expand)
(birewrite (Div (Num 1) (Mul b c)) (Mul (Div (Num 1) b) (Div (Num 1) c)) :ruleset expand)
(rewrite (Div (Sub a b) c) (Sub (Div a c) (Div b c)) :ruleset expand)
(rewrite (Div (Add a b) c) (Add (Div a c) (Div b c)) :ruleset expand)
(rewrite (Div (Mul a b) (Mul c d)) (Mul (Div a c) (Div b d)) :ruleset expand)
(rewrite (Add (Div p a) (Div q b)) (Div (Add (Mul p b) (Mul q a)) (Mul a b)) :ruleset expand)
(rewrite (Sub (Div p a) (Div q b)) (Div (Sub (Mul p b) (Mul q a)) (Mul a b)) :ruleset expand)

;; factoring / conjugate rewrites (structural, growing)
(rewrite (Sub (Mul a a) (Mul b b)) (Mul (Sub a b) (Add a b)) :ruleset expand)
(rewrite (Sub (Mul a a) (Num 1)) (Mul (Sub a (Num 1)) (Add a (Num 1))) :ruleset expand)

;; default ruleset: folding, identities, cancellation, normalization (non-growing)
(rewrite (Add (Num a) (Num b)) (Num (+ a b)))
(birewrite (Neg a) (Sub (Num 0) a))
(rewrite (Sub a b) (Add a (Neg b)))
(rewrite (Sub (Num a) (Num b)) (Num (- a b)))
(rewrite (Mul (Num a) (Num b)) (Num (* a b)))

(rewrite (Sub a (Add a b)) (Neg b))
(rewrite (Add (Neg a) (Neg b)) (Neg (Add a b)))
(rewrite (Div (Neg a) (Neg b)) (Div a b))
(birewrite (Neg (Sub a b)) (Sub b a))

(rewrite (Mul (Num 1) x) x)
(rewrite (Div x (Num 1)) x)
(rewrite (Add (Num 0) x) x)
(rewrite (Neg (Neg a)) a)

(rewrite (Mul (Neg a) (Neg a)) (Mul a a))
(rewrite (Mul (Sub a b) (Sub a b)) (Mul (Sub b a) (Sub b a)))
(rewrite (Sub a (Sub a b)) b)

;; fold multiply/divide by -1 and a negated literal coefficient into signed-coefficient form
(rewrite (Mul (Num -1) x) (Neg x))
(rewrite (Div x (Num -1)) (Neg x))
(rewrite (Neg (Mul (Num n) x)) (Mul (Num (* -1 n)) x))

;; additive inverse
(rewrite (Sub a a) (Num 0))
(rewrite (Add a (Neg a)) (Num 0))

;; flatten a quotient-of-quotient
(rewrite (Div (Div a b) c) (Div a (Mul b c)))

;; ------------------------------------------------------------------------------
;; Interval abstract interpretation, and the domain-conditional rewrites it guards.
;; ------------------------------------------------------------------------------

(function lo (Math) f64 :merge (max old new))
(function hi (Math) f64 :merge (min old new))

(rule ((= e (Num n)))
    ((set (lo e) (to-f64 n)) (set (hi e) (to-f64 n))))
(rule ((= e (Neg a)) (= la (lo a)) (= ha (hi a))) ((set (lo e) (neg ha))
    (set (hi e) (neg la))))
(rule ((= e (Add a b)) (= la (lo a)) (= lb (lo b)) (= ha (hi a)) (= hb (hi b)))
    ((set (lo e) (+ la lb)) (set (hi e) (+ ha hb))))
(rule ((= e (Sub a b)) (= la (lo a)) (= lb (lo b)) (= ha (hi a)) (= hb (hi b)))
    ((set (lo e) (- la hb)) (set (hi e) (- ha lb))))
(rule ((= e (Mul a b)) (= la (lo a)) (= lb (lo b)) (= ha (hi a)) (= hb (hi b)))
    ((set (lo e) (min (min (* la lb) (* la hb)) (min (* ha lb) (* ha hb))))
    (set (hi e) (max (max (* la lb) (* la hb)) (max (* ha lb) (* ha hb))))))
(rule ((= e (Div a b)) (= la (lo a)) (= lb (lo b)) (= ha (hi a)) (= hb (hi b)) (> lb 0.0))
    ((set (lo e) (min (min (/ la lb) (/ la hb)) (min (/ ha lb) (/ ha hb))))
    (set (hi e) (max (max (/ la lb) (/ la hb)) (max (/ ha lb) (/ ha hb))))))
(rule ((= e (Div a b)) (= la (lo a)) (= lb (lo b)) (= ha (hi a)) (= hb (hi b)) (< hb 0.0))
    ((set (lo e) (min (min (/ la lb) (/ la hb)) (min (/ ha lb) (/ ha hb))))
    (set (hi e) (max (max (/ la lb) (/ la hb)) (max (/ ha lb) (/ ha hb))))))
;; sqrt: sound bounds for t >= 0: min(t,1) <= sqrt(t) <= t+1.
(rule ((= e (Sqrt a)) (>= (lo a) 0.0) (= la (lo a)) (= ha (hi a)))
    ((set (lo e) (min la 1.0)) (set (hi e) (+ ha 1.0))))

;; sqrt-factoring: sound only where every sqrt operand is proven >= 0
(rule ((= e (Sqrt (Mul a b))) (>= (lo a) 0.0) (>= (lo b) 0.0)) ((union e (Mul (Sqrt a) (Sqrt b)))))
(rule ((= e (Sqrt (Div a b))) (>= (lo a) 0.0) (> (lo b) 0.0)) ((union e (Div (Sqrt a) (Sqrt b)))))
(rule ((= e (Mul (Sqrt a) (Sqrt a))) (>= (lo a) 0.0)) ((union e a)))

;; conjugate: p + sqrt(d) = (p^2 - d) / (p - sqrt(d))
(rule ((= e (Add p (Sqrt d))) (<= (hi p) 0.0) (> (lo d) 0.0))
    ((union e (Div (Sub (Mul p p) d) (Sub p (Sqrt d))))) :ruleset expand)

;; division cancellation: sound only where the cancelled factor a is proven != 0
(rule ((= e (Div (Mul a x) (Mul a y))) (> (lo a) 0.0)) ((union e (Div x y))))
(rule ((= e (Div (Mul a x) (Mul a y))) (< (hi a) 0.0)) ((union e (Div x y))))
(rule ((= e (Div (Mul a x) a)) (> (lo a) 0.0)) ((union e x)))
(rule ((= e (Div (Mul a x) a)) (< (hi a) 0.0)) ((union e x)))
(rule ((= e (Div a (Mul a y))) (> (lo a) 0.0)) ((union e (Div (Num 1) y))))
(rule ((= e (Div a (Mul a y))) (< (hi a) 0.0)) ((union e (Div (Num 1) y))))

;; sqrt(a+b) = sqrt(a)*sqrt(1 + b/a), pivot proven positive. Recurses (RHS re-exposes a
;; sqrt-of-sum): throttled in the prover; EXCLUDED from grammar compilation (egrammar.py
;; runs all rules unified, where this rule floods the grammar with deep sqrt spellings).
;; BEGIN grammar-excluded
(rule ((= e (Sqrt (Add a b))) (> (lo a) 0.0))
    ((union e (Mul (Sqrt a) (Sqrt (Add (Num 1) (Div b a)))))) :ruleset expand)
;; END grammar-excluded
